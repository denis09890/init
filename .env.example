# Copy this file to .env and adjust the values. .env is git-ignored; never commit it.
# Read by docker compose (repo root) and by the backend when it runs with the dev profile.

# PostgreSQL
DB_HOST=localhost
# Change to e.g. 5433 if a PostgreSQL installed directly on your machine already uses 5432.
DB_PORT=5432
DB_NAME=init
DB_USERNAME=init
DB_PASSWORD=change-me
